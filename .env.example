# Database
DATABASE_URL="file:./dev.db"

# Redis Cache (optional)
REDIS_URL="redis://localhost:6379"

# Google Maps API Keys
# Browser key: restricted to your HTTP referrer domain, allows Maps JavaScript API & Places API (New)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY="YOUR_GOOGLE_MAPS_BROWSER_KEY"

# Server key: restricted to server IP address, allows Routes API & Geocoding API
GOOGLE_MAPS_SERVER_KEY="YOUR_GOOGLE_MAPS_SERVER_KEY"

# App settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
