generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  campaigns Campaign[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  role           String   @default("CAMPAIGN_MANAGER") // SUPER_ADMIN, CAMPAIGN_ADMIN, CAMPAIGN_MANAGER, PA, DRIVER, FIELD_WORKER

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Campaign {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  candidateName  String
  constituency   String?
  startDate      DateTime?
  endDate        DateTime?
  timezone       String    @default("Asia/Kolkata")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    Location[]
  events       Event[]
  schedules    Schedule[]
  constraints  SchedulingConstraint[]
  versions     ScheduleVersion[]
  riskAssessments CampaignRiskAssessment[]
}

model Location {
  id         String   @id @default(cuid())
  campaignId String

  name       String
  address    String?
  latitude   Float
  longitude  Float
  placeId    String?
  category   String   @default("OTHER") // PARTY_OFFICE, VILLAGE, MEETING_HALL, GOVERNMENT_OFFICE, HOSPITAL, TEMPLE, MEDIA_LOCATION, RESIDENCE, PUBLIC_MEETING, OTHER

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events   Event[]
}

model Event {
  id              String    @id @default(cuid())
  campaignId      String
  locationId      String

  title           String
  description     String?
  eventType       String    @default("MEETING") // PUBLIC_MEETING, VILLAGE_VISIT, PRESS_CONF, VIP_MEETING, DOOR_TO_DOOR, RALLY, BREAK_REST
  date            String    // YYYY-MM-DD format for easy querying
  
  preferredStart  String?   // HH:mm
  preferredEnd    String?   // HH:mm
  fixedStart      String?   // HH:mm
  fixedEnd        String?   // HH:mm

  durationMinutes Int       @default(45)
  priority        Int       @default(50) // 1 - 100

  isFixed         Boolean   @default(false)
  isFlexible      Boolean   @default(true)
  status          String    @default("PLANNED") // PLANNED, COMPLETED, CANCELLED

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  scheduleItems ScheduleItem[]
  execution EventExecution?
}

model Schedule {
  id                  String   @id @default(cuid())
  campaignId          String
  date                String   // YYYY-MM-DD
  version             Int      @default(1)
  status              String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED, LOCKED
  optimizationProfile String   @default("BALANCED") // BALANCED, MIN_TRAVEL_TIME, MIN_DISTANCE, MAX_EVENTS

  totalDistanceMeters Int      @default(0)
  totalTravelSeconds  Int      @default(0)
  totalBufferSeconds  Int      @default(0)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items    ScheduleItem[]
}

model ScheduleItem {
  id                   String   @id @default(cuid())
  scheduleId           String
  eventId              String

  sequence             Int
  plannedArrival       String   // HH:mm
  plannedDeparture     String   // HH:mm

  travelDistanceMeters Int      @default(0)
  travelSeconds        Int      @default(0)
  bufferSeconds        Int      @default(0)
  lateRiskScore        Int      @default(0) // 0-100

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model CandidateAvailability {
  id            String   @id @default(cuid())
  candidateId   String
  candidateName String
  date          String   // YYYY-MM-DD
  startTime     String   // HH:mm
  endTime       String   // HH:mm
  status        String   @default("AVAILABLE") // AVAILABLE, UNAVAILABLE, PREFERRED, BLOCKED
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SchedulingConstraint {
  id         String   @id @default(cuid())
  campaignId String
  type       String   // WORKING_HOURS, MAX_DAILY_STOPS, MAX_TRAVEL_DISTANCE, MIN_BUFFER
  severity   String   @default("HARD") // HARD, SOFT
  value      String
  enabled    Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model ScheduleVersion {
  id              String   @id @default(cuid())
  campaignId      String
  scheduleId      String
  version         Int
  parentVersionId String?
  changeReason    String?

  createdAt       DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model EventExecution {
  id                    String    @id @default(cuid())
  eventId               String    @unique
  actualArrival         String?   // HH:mm
  actualStart           String?   // HH:mm
  actualEnd             String?   // HH:mm
  actualDurationMinutes Int?
  delayMinutes          Int       @default(0)
  status                String    @default("SCHEDULED") // SCHEDULED, APPROACHING, ARRIVED, IN_PROGRESS, COMPLETED, SKIPPED, DEPARTED
  notes                 String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model LiveLocation {
  id          String   @id @default(cuid())
  candidateId String
  latitude    Float
  longitude   Float
  accuracy    Float?
  speed       Float?
  heading     Float?
  timestamp   DateTime @default(now())
}

model PredictionModel {
  id                     String   @id @default(cuid())
  category               String
  minDurationMinutes     Int
  expectedDurationMinutes Int
  maxDurationMinutes     Int
  confidencePercent      Int
  sampleCount            Int
  updatedAt              DateTime @updatedAt
}

model CampaignRiskAssessment {
  id                   String   @id @default(cuid())
  campaignId           String
  overallRiskLevel     String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  predictedReliability Int      @default(85)
  warningFlagsCount    Int      @default(0)
  createdAt            DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model WhatIfSimulationLog {
  id                String   @id @default(cuid())
  scenarioType      String   // CANDIDATE_UNAVAILABILITY, TIME_SHIFT, ROUTE_CONGESTION
  inputPayload      String
  predictedDeltaKm  Float
  predictedDelayMin Int
  recommendedAction String
  createdTimestamp  DateTime @default(now())
}

model RouteMatrix {
  id                    String   @id @default(cuid())
  originLocationId      String
  destinationLocationId String

  distanceMeters        Int
  durationSeconds       Int

  calculatedAt          DateTime @default(now())

  @@unique([originLocationId, destinationLocationId])
}
